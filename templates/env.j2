TZ={{ anonymousoverflow_environment_variables_tz }}

{#
The port AnonymousOverflow listens on inside the container. It defaults to 8080
on its own (see `main.go`), which is also what this role defaults to, but the
port is published and routed to by number elsewhere (the `-p` flag in the
systemd unit and the Traefik loadbalancer label), so it has to be told.
Without this, changing `anonymousoverflow_container_http_port` moved the
published port and the Traefik route while the process kept listening on 8080.
#}

PORT={{ anonymousoverflow_container_http_port }}

{#
See: https://github.com/httpjamesm/AnonymousOverflow/blob/main/docker-compose.example.yml
#}

APP_URL={{ anonymousoverflow_environment_variable_app_url }}
JWT_SIGNING_SECRET={{ anonymousoverflow_environment_variable_jwt_signing_secret }}

{{ anonymousoverflow_environment_variables_additional_variables }}
